<%# Deliberately outside the workout display, which only exists once a session has started: the
    moment a device warning matters most is while the rider is still connecting things. %>
<article
  x-show="connectionWarning"
  class="connection-warning"
  role="alert"
>
  <span x-text="connectionWarning"></span>
</article>

<%# A failed connection used to leave nothing behind but a console line and a button quietly back
    on "Connect". There is no console to read on a phone. %>
<article x-show="deviceError" class="device-error" role="alert">
  <span x-text="deviceError"></span>
</article>
