<div x-show="showWorkout">
  <hgroup class="workout-heading">
    <h2>
      <span x-text="workoutMeta?.name"></span> •
      <span x-text="formatDuration(workoutMeta?.totalDuration)"></span>
    </h2>
    <p
      x-data="{clamp: 3}"
      class="workout-description"
      @click="clamp = clamp === 3 ? 100 : 3"
      x-bind:style="`-webkit-line-clamp: ${clamp}`"
    >
      <span x-text="workoutMeta?.description"></span>
      <cite
        x-show="workoutMeta?.author"
        x-text="` — ${workoutMeta?.author}`"
      ></cite>
    </p>
  </hgroup>

  <article x-show="isPaused" class="grid workout-panel">
    <div>
      <h4>Workout Paused</h4>
      <p>
        You have paused the workout. You can resume it by pedaling
        or stop it.
      </p>
    </div>
    <button class="outline" @click="stopWorkout">Stop</button>
  </article>

  <article x-show="workoutFinished" class="workout-panel">
    <div class="grid">
      <div>
        <h4>Workout Completed</h4>
        <p>
          You have completed the workout! You can now export your
          data and
          <a href="https://www.strava.com/upload/select" target="_blank"
            >share it on Strava</a
          >.
        </p>
      </div>
      <button @click="exportActivity">Export activity</button>
    </div>

    <%# What the ride was. Every number here comes from workoutSamples, which until now only ever
        left the app inside a .tcx file. One markup for both widths: the panel is read standing
        still, so nothing about it needs to differ between a phone and a TV. %>
    <section class="session-summary" x-show="summary" aria-label="Session summary">
      <dl>
        <div>
          <dt>Average power</dt>
          <dd x-text="metric(summary?.averagePower, 'W')"></dd>
        </div>
        <div>
          <dt>Normalised power</dt>
          <%# Nothing under thirty seconds of riding: the rolling window it is defined on has not
              closed once yet. %>
          <dd x-text="metric(summary?.normalisedPower, 'W')"></dd>
        </div>
        <div x-show="summary?.averageHeartRate">
          <dt>Average heart rate</dt>
          <dd x-text="metric(summary?.averageHeartRate, 'bpm')"></dd>
        </div>
      </dl>

      <div class="zone-bar" x-show="zones.length" aria-hidden="true">
        <template x-for="zone in zones" :key="zone.name">
          <span
            x-bind:style="`--zone: ${zone.color}; flex-grow: ${zone.percent}`"
          ></span>
        </template>
      </div>
      <ul class="zone-legend" x-show="zones.length">
        <template x-for="zone in zones" :key="zone.name">
          <li>
            <span class="zone-dot" x-bind:style="`--zone: ${zone.color}`"></span>
            <span x-text="zone.name"></span>
            <span class="zone-share" x-text="zoneShare(zone)"></span>
          </li>
        </template>
      </ul>
    </section>
  </article>

  <%# The cockpit: one screen, no layout switch. Shown instead of the table below 640px, where a
      four-column table is four cramped columns and the rider has about a second to read it. %>
  <section class="cockpit" aria-label="Current phase">
    <div
      class="cockpit-hero"
      x-bind:style="`--zone: ${phaseZone}`"
    >
      <p class="cockpit-phase">
        <span x-text="phase?.label"></span>
        <span x-show="phase" x-text="`· ${phasePercent(phase)}`"></span>
      </p>
      <p class="cockpit-countdown" x-text="phaseCountdown">0</p>
      <p class="cockpit-unit" x-text="phaseSecondsRemaining < 60 ? 'seconds' : 'remaining'">seconds</p>
      <progress x-bind:value="phaseProgress" max="100"></progress>
    </div>

    <ul class="cockpit-metrics">
      <li>
        <span class="v" x-text="power">-</span>
        <span class="k">watts<span x-show="phase?.watts" x-text="` ↑${phase?.watts}`"></span></span>
      </li>
      <li>
        <span class="v" x-text="cadence" x-bind:class="getCadenceStatus()">-</span>
        <span class="k">rpm<span x-text="cadenceTargetLabel"></span></span>
      </li>
      <li>
        <span class="v" x-text="heartRate">-</span>
        <span class="k">bpm</span>
      </li>
    </ul>

    <div class="cockpit-next" x-show="nextPhase">
      <p class="k">Next</p>
      <p class="cockpit-next-name">
        <span x-text="nextPhase?.label"></span>
        <span x-text="formatDuration((nextPhase?.duration || 0) / 60)"></span>
      </p>
      <p class="k" x-text="phaseIntensity(nextPhase)"></p>
    </div>

    <div class="cockpit-session">
      <span class="k">Session</span>
      <span class="cockpit-session-time">
        <span x-text="timer">0:00</span>
        <span class="cockpit-total" x-text="`/ ${sessionTotal}`"></span>
      </span>
    </div>
    <progress class="cockpit-session-bar" x-bind:value="sessionProgress" max="100"></progress>
    <%# Sits directly above the workout band, which is the thing it counts into. %>
    <p class="k cockpit-band-label" x-text="`phase ${phase?.number}/${phase?.count}`"></p>
  </section>

  <table class="workout-data">
    <thead>
      <tr>
        <th>Time</th>
        <th>Power</th>
        <th>Cadence</th>
        <th>Heart Rate</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td x-text="timer">0:00</td>
        <td><span x-text="power">-</span> W</td>
        <td>
          <span x-text="cadence + '  rpm'" x-bind:class="getCadenceStatus()">-</span>
          <small 
            class="cadence-target"
            x-show="cadenceTarget?.type === 'fixed'" 
            x-text="' - Target: ' + cadenceTarget?.target">
          </small>
          <small 
            class="cadence-target"
            x-show="cadenceTarget?.type === 'range'" 
            x-text="' - Target: ' + cadenceTarget?.min + '-' + cadenceTarget?.max">
          </small>
        </td>
        <td><span x-text="heartRate">-</span> bpm</td>
      </tr>
    </tbody>
  </table>
  <div class="phase-progress-container">
    <span x-text="phaseTimeRemaining">0:00</span>
    <progress x-bind:value="phaseProgress" max="100"></progress>
  </div>

  <div x-ref="workoutSvg" class="workout-svg-container"></div>
</div>