<workout_file>
  <name>Rowing Intervals</name>
  <description>Two minutes of steady work, split into short pieces. Time-based, so it runs the same on a rower as it would on a bike.</description>
  <author>web-erg</author>
  <sportType>rowing</sportType>
  <workout>
    <Warmup Duration="30" PowerLow="0.5" PowerHigh="0.6"/>
    <IntervalsT Repeat="2" OnDuration="20" OffDuration="20" OnPower="0.9" OffPower="0.5"/>
    <Cooldown Duration="30" PowerLow="0.6" PowerHigh="0.4"/>
  </workout>
</workout_file>
