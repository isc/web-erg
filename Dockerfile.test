# The image the suite runs in on the Charras server, which has no Ruby and no Chrome of its own.
# Recorded here rather than living only in that machine's docker daemon: an image nobody can rebuild
# is a machine nobody can replace.
#
#   docker build -f Dockerfile.test -t web-erg-test .
#   docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp \
#     -v "$PWD":/app -w /app -e BUNDLE_PATH=/app/vendor/bundle -e CI=true \
#     web-erg-test bash -lc "bundle exec rake test"
#
# --user because the repo is bind-mounted: as root the container writes vendor/bundle and tmp/ into
# your own working tree owned by root, and the host cannot clean up after it. HOME has to be
# writable, since that uid has no passwd entry here.
#
# CI=true is what passes --no-sandbox to Chrome. The container has no usable sandbox whoever it runs
# as, so this is needed with --user just as it was without.
FROM ruby:3.4

# Debian's chromium, not Google Chrome: Ferrum only needs a CDP endpoint, and this one is packaged
# for the same distribution the ruby image is built on. fonts-liberation because a browser with no
# fonts lays text out at the wrong width, and the suite asserts on what a phone-sized screen shows.
#
# librsvg2-bin is not for the suite: it is what scripts/generate_icons.sh needs, because the
# ImageMagick this image already carries renders SVG through its own reader and returns a picture
# that is not the drawing. The icons are committed, so only whoever changes them needs it — on a
# machine that has no Ruby either, which is why it is recorded here rather than installed by hand.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    chromium fonts-liberation ca-certificates librsvg2-bin \
  && rm -rf /var/lib/apt/lists/*
